<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF owns the application entry point and DPI manifest; WinForms is only used for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <ApplicationIcon>../../assets/streamdock.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StreamDock</AssemblyName>
    <Version>1.0.0</Version>
    <Copyright>StreamDock contributors, 2026. GPL-3.0-or-later.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StreamDock.Core/StreamDock.Core.csproj" />
    <EmbeddedResource Include="../../payload/tools.zip" LogicalName="StreamDock.tools.zip" />
    <EmbeddedResource Include="../../payload/tools.manifest.json" LogicalName="StreamDock.tools.manifest.json" />
    <EmbeddedResource Include="../../assets/streamdock.ico" LogicalName="StreamDock.icon.ico" />
  </ItemGroup>
</Project>
