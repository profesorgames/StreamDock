<Window x:Class="StreamDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StreamDock" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="StreamDock" Width="1220" Height="850" MinWidth="1040" MinHeight="720" Background="#10141E" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Foreground="#EDF2FC" Loaded="WindowLoaded" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#303A4F" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#121824" MouseLeftButtonDown="DragTitle">
      <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center"><TextBlock Text="↧" Foreground="#7FC1FF" FontSize="23" FontWeight="Bold" Margin="0,0,9,0"/><TextBlock Text="streamdock" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#243346" CornerRadius="4" Margin="12,0,0,0" Padding="6,2"><TextBlock Text="PORTABLE" Foreground="#97C2F1" FontSize="9" FontWeight="Bold"/></Border></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" ToolTip="Свернуть" Click="MinimizeClick" Style="{StaticResource QuietButton}" Width="46"/><Button Content="□" ToolTip="Развернуть" Click="MaximizeClick" Style="{StaticResource QuietButton}" Width="46"/><Button Content="✕" ToolTip="Закрыть / свернуть в трей" Click="CloseClick" Style="{StaticResource QuietButton}" Width="46"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#121824" BorderBrush="#242D3E" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,30,0,0"><TextBlock Text="ВАША МЕДИАТЕКА" Foreground="#667995" FontSize="10" FontWeight="SemiBold" Margin="28,0,0,15"/>
            <RadioButton x:Name="DownloadsNav" Content="↧   Загрузки" GroupName="Pages" Tag="DownloadsPage" Style="{StaticResource Nav}" Checked="Navigate" IsChecked="True"/>
            <RadioButton Content="♫   Spotify" GroupName="Pages" Tag="SpotifyPage" Style="{StaticResource Nav}" Checked="Navigate"/>
            <RadioButton Content="⚙   Настройки" GroupName="Pages" Tag="SettingsPage" Style="{StaticResource Nav}" Checked="Navigate"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,24"><Border Background="#1A2636" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="Всё в одном EXE" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Компоненты уже внутри.&#10;Без установки." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border><TextBlock Text="StreamDock / 1.0.0" Foreground="#667995" FontSize="11" Margin="4,18,0,0"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="32,23,32,15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="NoticeBar" Background="#29374E" BorderBrush="#587FA9" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="12" Foreground="#DDEBFF"/><Button Grid.Column="1" Content="✕" Style="{StaticResource QuietButton}" Padding="3" Click="DismissNotice"/></Grid></Border>
        <Grid Grid.Row="1" x:Name="PageHost">
          <Grid x:Name="DownloadsPage">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,22"><StackPanel><TextBlock Text="Сохранить. И оставить себе." Foreground="#EDF2FC" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Видео, музыка, изображения и файлы — по одной ссылке." Foreground="#9AA8BE" Margin="0,7,0,0"/></StackPanel><Button Content="↗  Папка" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}" Click="OpenDownloads"/></Grid>
            <Border Grid.Row="1" Background="#171D2B" BorderBrush="#2A3347" BorderThickness="1" CornerRadius="13" Padding="20">
              <StackPanel><TextBlock Text="ДОБАВИТЬ ССЫЛКУ" FontSize="10" FontWeight="SemiBold" Foreground="#9AA8BE" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="UrlBox" FontSize="15" KeyDown="UrlKeyDown" AutomationProperties.Name="Ссылка для загрузки"/><TextBlock Text="https://  Вставьте ссылку на медиа или файл" Foreground="#657993" Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=UrlBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><Button Grid.Column="1" x:Name="InspectButton" Content="Найти медиа  →" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="InspectClick"/></Grid>
                <TextBlock Text="YouTube  ·  TikTok  ·  Instagram  ·  другие сайты и прямые ссылки" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" x:Name="MediaCard" Background="#192639" BorderBrush="#365775" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,12,0,0" Visibility="Collapsed">
              <StackPanel><TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MediaDescription" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="0,0,10,0"><ComboBoxItem Content="Видео"/><ComboBoxItem Content="Аудио · MP3"/><ComboBoxItem Content="Оригинал / изображения"/></ComboBox><ComboBox Grid.Column="1" x:Name="QualityBox" Margin="0,0,14,0"/><Button Grid.Column="2" x:Name="AddButton" Content="↓  В очередь" Style="{StaticResource PrimaryButton}" Click="AddClick"/></Grid>
              </StackPanel>
            </Border>
            <Grid Grid.Row="3" Margin="0,23,0,12"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Очередь" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="QueueStats" Text="Пока пусто" Foreground="#8D9EB6" Margin="14,4,0,0" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PauseButton" Content="Ⅱ  Пауза очереди" Style="{StaticResource QuietButton}" Click="PauseClick" FontSize="12"/><Button Content="Очистить готовые" Style="{StaticResource QuietButton}" Click="ClearClick" FontSize="12"/></StackPanel></Grid>
            <Grid Grid.Row="4"><ListBox x:Name="JobsList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"><Button Content="↗" ToolTip="Открыть папку" Click="JobFolderClick" Style="{StaticResource QuietButton}"/><Button Content="↻" ToolTip="Повторить" Click="RetryClick" IsEnabled="{Binding CanRetry}" Style="{StaticResource QuietButton}"/><Button Content="✕" ToolTip="Отменить загрузку" Click="CancelJobClick" Style="{StaticResource QuietButton}"/></StackPanel></Grid><local:SmoothProgress Grid.Row="1" AnimatedValue="{Binding Percent}" Margin="0,13,0,10"/><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" FontSize="11" Foreground="#93A6C1"/><TextBlock Grid.Column="1" FontSize="11" Foreground="#8DC7FF" Margin="16,0,0,0"><Run Text="{Binding Status, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Percent, Mode=OneWay, StringFormat={}{0:0}%}"/></TextBlock></Grid></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox><StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,20"><TextBlock Text="↧" FontSize="48" Foreground="#3E6085" HorizontalAlignment="Center"/><TextBlock Text="Здесь появятся ваши загрузки" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock Text="Вставьте ссылку выше — остальное уже готово." Foreground="#8093AE" Margin="0,8,0,0" FontSize="13"/></StackPanel></Grid>
          </Grid>
          <Grid x:Name="SpotifyPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,22"><TextBlock Text="Сейчас играет. Скоро у вас." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Spotify подскажет трек. Вы выберете подходящую запись." Foreground="#9AA8BE" Margin="0,7,0,0"/></StackPanel>
            <Border Grid.Row="1" Background="#142B26" BorderBrush="#285449" BorderThickness="1" CornerRadius="13" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="♫  Spotify" FontSize="21" FontWeight="SemiBold" Foreground="#86E4BC"/><TextBlock x:Name="SpotifyStatus" Text="Подключите аккаунт через браузер" Foreground="#98B9AE" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" x:Name="ConnectButton" Content="Подключить Spotify" Click="ConnectSpotifyClick" Background="#71DDAA" Foreground="#072117" VerticalAlignment="Center"/></Grid></Border>
            <Border Grid.Row="2" Background="#171D2B" BorderBrush="#2A3347" BorderThickness="1" CornerRadius="12" Margin="0,16,0,12" Padding="20"><StackPanel><TextBlock x:Name="TrackTitle" Text="Включите песню в Spotify" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="TrackArtist" Text="Затем нажмите «Найти текущий трек»" Foreground="#93A6C1" Margin="0,7,0,14"/><Button x:Name="FindTrackButton" Content="Найти текущий трек  →" HorizontalAlignment="Left" Click="FindTrackClick" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
            <ListBox Grid.Row="3" x:Name="CandidatesList" SelectionMode="Single"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#9AA8BE" FontSize="12" Margin="0,7,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel Grid.Row="4" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Источник: YouTube · проверьте версию и длительность" Foreground="#8D9EB6" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,15,0"/><Button Grid.Column="1" x:Name="DownloadTrackButton" Content="↓  Сохранить выбранное в MP3" Click="DownloadTrackClick" Style="{StaticResource PrimaryButton}" IsEnabled="False"/></Grid><TextBlock Text="Аудио скачивается из выбранного внешнего источника. Spotify предоставляет только метаданные." Foreground="#71849E" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
          </Grid>
          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0"><TextBlock Text="Подстроить под себя." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Тихая работа. Понятные настройки." Foreground="#9AA8BE" Margin="0,7,0,23"/>
            <Border Background="#171D2B" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="Файлы и очередь" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Папка для загрузок" Style="{StaticResource Caption}" Margin="0,16,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderBox"/><Button Grid.Column="1" Content="Выбрать…" Click="ChooseFolderClick" Margin="10,0,0,0"/></Grid><TextBlock Text="Одновременных загрузок" Style="{StaticResource Caption}" Margin="0,15,0,8"/><ComboBox x:Name="ConcurrencyBox" Width="170" HorizontalAlignment="Left"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox><CheckBox x:Name="TrayCheck" Content="Сворачивать в трей при закрытии окна" Margin="0,18,0,7"/><CheckBox x:Name="StartupCheck" Content="Запускать с Windows сразу в трей, без окна"/><TextBlock Text="Автозапуск действует для текущего пользователя. После перемещения EXE сохраните настройки заново." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="#171D2B" CornerRadius="12" Padding="22" Margin="0,15,0,0"><StackPanel><TextBlock Text="Подключение Spotify" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Создайте приложение в Spotify Developer Dashboard, добавьте свой аккаунт в список пользователей и укажите Redirect URI точно как ниже. Требования доступа определяет Spotify." Foreground="#9AA8BE" TextWrapping="Wrap" Margin="0,10,0,10"/><Button Content="Открыть Spotify Developer Dashboard ↗" HorizontalAlignment="Left" Click="SpotifyDashboardClick" Style="{StaticResource QuietButton}"/><TextBlock Text="Client ID · без Client Secret" Style="{StaticResource Caption}" Margin="0,12,0,8"/><TextBox x:Name="ClientIdBox" MaxLength="32"/><TextBlock Text="Redirect URI" Style="{StaticResource Caption}" Margin="0,12,0,8"/><TextBox Text="http://127.0.0.1:43829/callback/" IsReadOnly="True"/><Button Content="Отключить Spotify и удалить токены" HorizontalAlignment="Left" Click="DisconnectSpotifyClick" Style="{StaticResource QuietButton}" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Background="#171D2B" CornerRadius="12" Padding="22" Margin="0,15,0,0"><StackPanel><TextBlock Text="Доступ к сайтам" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Необязательно: путь к cookies.txt в формате Netscape для сайтов, которым нужен вход. Файл остаётся на вашем компьютере." Foreground="#9AA8BE" TextWrapping="Wrap" Margin="0,10,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CookiesBox"/><Button Grid.Column="1" Content="Выбрать…" Click="ChooseCookiesClick" Margin="10,0,0,0"/></Grid></StackPanel></Border>
            <Button Content="Сохранить настройки" Click="SaveSettingsClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,14"/><TextBlock Text="Компоненты: yt-dlp · FFmpeg · Deno · gallery-dl · .NET. Лицензия приложения: GPL-3.0-or-later." Foreground="#71849E" FontSize="11" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Button Content="Папка данных ↗" Style="{StaticResource QuietButton}" Click="OpenDataClick" FontSize="12"/><Button Content="Компоненты и лицензии ↗" Style="{StaticResource QuietButton}" Click="OpenComponentsClick" FontSize="12"/></StackPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#121824" BorderBrush="#242D3E" BorderThickness="0,1,0,0"><Grid Margin="20,0"><TextBlock x:Name="StatusText" Text="Подготовка встроенных компонентов…" Foreground="#8397B4" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="WINDOWS x64  /  PORTABLE" Foreground="#566B88" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    <Border x:Name="LoadingOverlay" Grid.Row="1" Background="#E610141E"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420"><TextBlock Text="↧" FontSize="60" HorizontalAlignment="Center" Foreground="#76B7FF"/><TextBlock Text="Всё нужное — уже внутри." FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock x:Name="LoadingText" Text="Подготовка компонентов…" Foreground="#A2B5D0" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"/></StackPanel></Border>
  </Grid></Border>
</Window>
